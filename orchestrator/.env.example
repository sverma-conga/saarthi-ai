# API Key (required)
# For GitHub Models: use your GitHub Personal Access Token (PAT)
# For OpenAI direct: use your sk-... key
OPENAI_API_KEY=ghp_your-github-pat-here

# Base URL (defaults to GitHub Models)
# GitHub Models: https://models.inference.ai.azure.com
# OpenAI direct: https://api.openai.com/v1
OPENAI_BASE_URL=https://models.inference.ai.azure.com

# Model to use (optional, defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Server config (optional)
HOST=0.0.0.0
PORT=8001
